<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - СМК</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        /* Стили, которые работают в Index – перенесены сюда */
        body {
            background: #fef5f5 !important;
        }

        .container, .main-content {
            background: white !important;
            border-radius: 28px !important;
            padding: 2rem !important;
        }

        h1, h2, h3 {
            color: #b96b6b !important;
        }

        .btn {
            border-radius: 40px !important;
            padding: 6px 20px !important;
            border: none !important;
        }

        .btn-primary {
            background: #d9a7a7 !important;
            color: white !important;
        }

            .btn-primary:hover {
                background: #c48b8b !important;
            }

        .btn-success {
            background: #c1d4b1 !important;
            color: #2d2d2d !important;
        }

        .btn-info {
            background: #b8d9e6 !important;
            color: #2d2d2d !important;
        }

        .btn-danger {
            background: #e0b4b4 !important;
            color: white !important;
        }

        .btn-secondary {
            background: #e9e1e1 !important;
            color: #5a4a4a !important;
        }

        .table thead th {
            background: #fef8f8 !important;
            color: #b96b6b !important;
        }

        a:not(.btn) {
            color: #b96b6b !important;
        }

        .form-control {
            border-radius: 24px !important;
            border: 1px solid #f5dfdf !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="main-content">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>