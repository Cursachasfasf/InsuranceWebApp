@model InsuranceWebApp.Models.Contract

@{
    ViewData["Title"] = "Добавить договор";
    Layout = "_Layout";
}

<h1>Добавить договор</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" action="/Contracts/Create">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="control-label">ID клиента</label>
                <input name="client_id" class="form-control" type="number" required />
            </div>
            <div class="form-group">
                <label class="control-label">ID продукта</label>
                <input name="product_id" class="form-control" type="number" required />
            </div>
            <div class="form-group">
                <label class="control-label">ID сотрудника</label>
                <input name="employee_id" class="form-control" type="number" required />
            </div>
            <div class="form-group">
                <label class="control-label">Страховая премия</label>
                <input name="insurance_premium" class="form-control" step="0.01" required />
            </div>
            <div class="form-group">
                <label class="control-label">Страховая сумма</label>
                <input name="insurance_amount" class="form-control" step="0.01" required />
            </div>
            <div class="form-group">
                <label class="control-label">Дата начала</label>
                <input name="start_date" class="form-control" type="date" required />
            </div>
            <div class="form-group">
                <label class="control-label">Дата окончания</label>
                <input name="end_date" class="form-control" type="date" required />
            </div>
            <div class="form-group">
                <label class="control-label">Статус</label>
                <input name="status" class="form-control" required />
            </div>
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Создать</button>
                <a href="/Contracts" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>