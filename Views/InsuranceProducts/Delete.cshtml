@model InsuranceWebApp.Models.InsuranceProduct

@{
    ViewData["Title"] = "Удалить продукт";
    Layout = "_Layout";
}

<h1>Удалить продукт</h1>
<div class="alert alert-danger"><h3>Вы уверены?</h3></div>
<dl class="row">
    <dt class="col-sm-2">Название</dt>
    <dd class="col-sm-10">@Model.Name</dd>
</dl>
<form method="post" action="/InsuranceProducts/Delete/@Model.product_id">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a href="/InsuranceProducts" class="btn btn-secondary">Отмена</a>
</form>