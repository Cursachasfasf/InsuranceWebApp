@model InsuranceWebApp.Models.Employee

@{
    ViewData["Title"] = "Редактировать сотрудника";
    Layout = "_Layout";
}

<h1>Редактировать сотрудника</h1>

<form method="post" action="/Employees/Edit/@Model.employee_id">
    @Html.AntiForgeryToken()
    <input type="hidden" name="employee_id" value="@Model.employee_id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Имя</label>
            <input name="Name" value="@Model.Name" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Фамилия</label>
            <input name="Step_Name" value="@Model.Step_Name" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Отчество</label>
            <input name="S_Step_Name" value="@Model.S_Step_Name" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Должность</label>
            <input name="position" value="@Model.position" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Телефон</label>
            <input name="phone" value="@Model.phone" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Email</label>
            <input name="email" value="@Model.email" class="form-control" type="email" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a href="/Employees" class="btn btn-secondary">Назад</a>
    </div>
</form>