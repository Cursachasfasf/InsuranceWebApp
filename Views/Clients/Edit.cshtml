@model InsuranceWebApp.Models.Client

@{
    ViewData["Title"] = "Редактировать клиента";
    Layout = "_Layout";
}

<h1>Редактировать клиента</h1>

<form method="post" action="/Clients/Edit/@Model.client_id">
    @Html.AntiForgeryToken()
    <input type="hidden" name="client_id" value="@Model.client_id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Имя</label>
            <input name="Name" value="@Model.Name" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Фамилия</label>
            <input name="Step_Name" value="@Model.Step_Name" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Отчество</label>
            <input name="S_Step_Name" value="@Model.S_Step_Name" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Телефон</label>
            <input name="phone" value="@Model.phone" class="form-control" required />
        </div>
        <div class="col-md-12 mb-3">
            <label class="form-label">Адрес</label>
            <input name="address" value="@Model.address" class="form-control" required />
        </div>
        <div class="col-md-12 mb-3">
            <label class="form-label">Email</label>
            <input name="email" value="@Model.email" class="form-control" type="email" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a href="/Clients" class="btn btn-secondary">Назад</a>
    </div>
</form>