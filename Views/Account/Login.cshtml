@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h2 class="text-center mb-4" style="color: #b96b6b;">Вход в систему</h2>
            <form method="post" action="/Account/Login?returnUrl=@ViewBag.ReturnUrl">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="email" class="form-control" type="email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <input name="password" class="form-control" type="password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Войти</button>
                <div class="mt-3 text-center">
                    <a href="/Account/Register">Нет аккаунта? Зарегистрироваться</a>
                </div>
                <div asp-validation-summary="All" class="text-danger mt-2"></div>
            </form>
        </div>
    </div>
</div>