@model InsuranceWebApp.Models.InsuranceSituation

@{
    ViewData["Title"] = "Редактировать страховую ситуацию";
}

<h1>Редактировать страховую ситуацию</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" action="/InsuranceSituations/Edit/@Model.situation_id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="situation_id" value="@Model.situation_id" />
            <div class="form-group mb-3">
                <label class="form-label">ID договора</label>
                <input name="contract_id" class="form-control" type="number" value="@Model.contract_id" required />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">ID сотрудника</label>
                <input name="employee_id" class="form-control" type="number" value="@Model.employee_id" required />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Статус</label>
                <input name="status" class="form-control" value="@Model.status" required />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Сумма ущерба</label>
                <input name="damage_amount" class="form-control" step="0.01" value="@Model.damage_amount" required />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Описание</label>
                <textarea name="description" class="form-control" rows="3">@Model.description</textarea>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Дата инцидента</label>
                <input name="incident_date" class="form-control" type="date" value="@Model.incident_date.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Дата заявления</label>
                <input name="claim_date" class="form-control" type="date" value="@Model.claim_date.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Сохранить</button>
                <a href="/InsuranceSituations" class="btn btn-secondary rounded-pill px-4">Назад</a>
            </div>
        </form>
    </div>
</div>