@model IEnumerable<InsuranceWebApp.Models.Employee>

@{
    ViewData["Title"] = "Сотрудники";
}

<h1>Сотрудники</h1>

<p>
    <a href="/Employees/Create" class="btn btn-success">+ Добавить сотрудника</a>
</p>

<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Имя</th>
                <th>Фамилия</th>
                <th>Отчество</th>
                <th>Должность</th>
                <th>Телефон</th>
                <th>Email</th>
                <th>Дата найма</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Step_Name</td>
                    <td>@(item.S_Step_Name ?? "—")</td>
                    <td>@item.position</td>
                    <td>@item.phone</td>
                    <td>@item.email</td>
                    <td>@item.hire_date.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a href="/Employees/Edit/@item.employee_id" class="btn btn-sm btn-primary">Редактировать</a>
                        <a href="/Employees/Details/@item.employee_id" class="btn btn-sm btn-info">Детали</a>
                        <a href="/Employees/Delete/@item.employee_id" class="btn btn-sm btn-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>