@model InsuranceWebApp.Models.Client

@{
    ViewData["Title"] = "Добавить клиента";
    Layout = "_Layout";
}

<h1>Добавить клиента</h1>

<form method="post" action="/Clients/Create">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Имя</label>
            <input name="Name" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Фамилия</label>
            <input name="Step_Name" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Отчество</label>
            <input name="S_Step_Name" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Телефон</label>
            <input name="phone" class="form-control" required />
        </div>
        <div class="col-md-12 mb-3">
            <label class="form-label">Адрес</label>
            <input name="address" class="form-control" required />
        </div>
        <div class="col-md-12 mb-3">
            <label class="form-label">Email</label>
            <input name="email" class="form-control" type="email" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Создать</button>
        <a href="/Clients" class="btn btn-secondary">Назад</a>
    </div>
</form>