@model IEnumerable<InsuranceWebApp.Models.InsuranceProduct>

@{
    ViewData["Title"] = "Страховые продукты";
    Layout = "_Layout";
}

<h1>Страховые продукты</h1>
<p>
    <a href="/InsuranceProducts/Create" class="btn btn-success">+ Добавить продукт</a>
</p>
<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr><th>Название</th><th>Тип</th><th>Описание</th><th>Тариф (%)</th><th>Мин. срок</th><th>Макс. срок</th><th>Действия</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.insurance_type</td>
                    <td>@item.description</td>
                    <td>@item.tariff_rate</td>
                    <td>@item.min_term_days</td>
                    <td>@item.max_term_days</td>
                    <td>
                        <a href="/InsuranceProducts/Edit/@item.product_id" class="btn btn-sm btn-primary">Ред.</a>
                        <a href="/InsuranceProducts/Details/@item.product_id" class="btn btn-sm btn-info">Дет.</a>
                        <a href="/InsuranceProducts/Delete/@item.product_id" class="btn btn-sm btn-danger">Уд.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>