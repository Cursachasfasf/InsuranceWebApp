@model InsuranceWebApp.Models.Contract

@{
    ViewData["Title"] = "Удалить договор";
    Layout = "_Layout";
}

<h1>Удалить договор</h1>
<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить этот договор?</h3>
</div>
<dl class="row">
    <dt class="col-sm-2">№ договора</dt>
    <dd class="col-sm-10">@Model.contract_id</dd>
    <dt class="col-sm-2">Клиент</dt>
    <dd class="col-sm-10">@Model.client_id</dd>
    <dt class="col-sm-2">Страх. сумма</dt>
    <dd class="col-sm-10">@Model.insurance_amount</dd>
</dl>
<form method="post" action="/Contracts/Delete/@Model.contract_id">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a href="/Contracts" class="btn btn-secondary">Отмена</a>
</form>