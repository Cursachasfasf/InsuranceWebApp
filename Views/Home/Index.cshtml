@{
    ViewData["Title"] = "Главная";
    Layout = "_Layout";
}

<div style="text-align: center; padding: 1rem 0 2rem 0;">
    <h1>Добро пожаловать в СМК Страхование</h1>
    <p class="lead">Управление клиентами, договорами, сотрудниками и страховыми продуктами</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 24px; border: none;">
            <div class="card-body text-center">
                <h3 class="card-title">👥 Клиенты</h3>
                <p class="card-text">Просмотр, добавление, редактирование и удаление клиентов.</p>
                <a href="/Clients" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 24px; border: none;">
            <div class="card-body text-center">
                <h3 class="card-title">👨‍💼 Сотрудники</h3>
                <p class="card-text">Управление сотрудниками компании.</p>
                <a href="/Employees" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 24px; border: none;">
            <div class="card-body text-center">
                <h3 class="card-title">📄 Договоры</h3>
                <p class="card-text">Учет заключенных договоров страхования.</p>
                <a href="/Contracts" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 24px; border: none;">
            <div class="card-body text-center">
                <h3 class="card-title">📦 Страховые продукты</h3>
                <p class="card-text">Список доступных страховых продуктов.</p>
                <a href="/InsuranceProducts" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 24px; border: none;">
            <div class="card-body text-center">
                <h3 class="card-title">💰 Платежи</h3>
                <p class="card-text">История платежей по договорам.</p>
                <a href="/Payments" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm" style="border-radius: 24px; border: none;">
            <div class="card-body text-center">
                <h3 class="card-title">💸 Выплаты</h3>
                <p class="card-text">Данные о страховых выплатах.</p>
                <a href="/Payouts" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>
</div>