<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - СМК Страхование</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        body {
            background: #b96b6b;
            font-family: 'Segoe UI', Roboto, sans-serif;
            padding: 20px 0;
        }

        .app-container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 32px;
            box-shadow: 0 20px 35px rgba(0,0,0,0.1);
            display: flex;
            min-height: 85vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background: #fffaf8;
            border-right: 1px solid #f0e2e2;
            padding: 1.5rem 0;
        }

        .sidebar-brand {
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
            color: #b96b6b;
            padding: 0 1rem 1.5rem;
            border-bottom: 1px solid #f0e2e2;
            margin-bottom: 1rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-nav li {
                margin: 0.25rem 0;
            }

            .sidebar-nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.75rem 1.5rem;
                color: #5a4a4a;
                text-decoration: none;
                transition: 0.2s;
                font-weight: 500;
            }

                .sidebar-nav a:hover, .sidebar-nav a.active {
                    background: #d9a7a7;
                    color: white;
                    border-radius: 0 20px 20px 0;
                }

            .sidebar-nav i {
                width: 24px;
            }

        .main-content {
            flex: 1;
            padding: 1.5rem 2rem;
            display: flex;
            flex-direction: column;
        }

        .breadcrumb-area {
            font-size: 0.9rem;
            margin-bottom: 1rem;
            color: #aaa;
        }

            .breadcrumb-area a {
                color: #b96b6b;
                text-decoration: none;
            }
        /* Глобальные стили кнопок */
        .btn-primary {
            background: #d9a7a7;
            border: none;
            color: #4a2e2e;
            border-radius: 40px;
            padding: 6px 20px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .btn-primary:hover {
                background: #c48b8b;
                color: white;
                transform: translateY(-2px);
            }

        .btn-secondary {
            background: #f5e6e6;
            border: none;
            color: #b96b6b;
            border-radius: 40px;
            padding: 6px 20px;
            font-weight: 500;
        }

            .btn-secondary:hover {
                background: #e6d0d0;
                color: #9e5252;
                transform: translateY(-2px);
            }

        .btn-danger {
            background: #e0b4b4;
            border: none;
            color: #4a2e2e;
            border-radius: 40px;
        }

            .btn-danger:hover {
                background: #d19b9b;
                color: white;
            }

        .btn-success {
            background: #c1d4b1;
            border: none;
            color: #2d2d2d;
            border-radius: 40px;
        }

            .btn-success:hover {
                background: #aec09a;
                transform: translateY(-2px);
            }

        .btn-info {
            background: #b8d9e6;
            border: none;
            color: #2d2d2d;
            border-radius: 40px;
        }
        /* Стили для таблиц и кнопок действий */
        .table-custom {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }

            .table-custom thead th {
                background: #fef8f8;
                color: #b96b6b;
                font-weight: 600;
                border-bottom: none;
            }

            .table-custom td, .table-custom th {
                padding: 12px 15px;
                vertical-align: middle;
            }

        .btn-action {
            border-radius: 40px;
            padding: 5px 14px;
            font-size: 0.85rem;
            margin: 0 3px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-action i {
                font-size: 0.9rem;
            }

        .btn-edit {
            background: #d9a7a7;
            color: #4a2e2e;
            border: none;
        }

            .btn-edit:hover {
                background: #c48b8b;
                color: white;
                transform: translateY(-2px);
            }

        .btn-details {
            background: #b8d9e6;
            color: #2d2d2d;
            border: none;
        }

            .btn-details:hover {
                background: #9ec5d4;
                color: white;
                transform: translateY(-2px);
            }

        .btn-delete {
            background: #e0b4b4;
            color: #4a2e2e;
            border: none;
        }

            .btn-delete:hover {
                background: #d19b9b;
                color: white;
                transform: translateY(-2px);
            }

        .user-info {
            text-align: right;
            margin-bottom: 1rem;
        }

        footer {
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid #f0e2e2;
            text-align: center;
            color: #aaa;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .app-container {
            max-width: 95%;
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-shield-alt"></i> СМК
            </div>
            <ul class="sidebar-nav">
                <li><a href="/"><i class="fas fa-tachometer-alt"></i> Главная</a></li>
                <li><a href="/Clients"><i class="fas fa-users"></i> Клиенты</a></li>
                <li><a href="/Employees"><i class="fas fa-user-tie"></i> Сотрудники</a></li>
                <li><a href="/Contracts"><i class="fas fa-file-signature"></i> Договоры</a></li>
                <li><a href="/InsuranceProducts"><i class="fas fa-boxes"></i> Продукты</a></li>
                <li><a href="/Payments"><i class="fas fa-credit-card"></i> Платежи</a></li>
                <li><a href="/Payouts"><i class="fas fa-money-bill-wave"></i> Выплаты</a></li>
                <li><a href="/Users"><i class="fas fa-users"></i> Пользователи</a></li>
                <li><a href="/InsuranceSituations"><i class="fas fa-exclamation-triangle"></i> Ситуации</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a href="/Admin/Users"><i class="fas fa-user-shield"></i> Управление ролями</a></li>
                }
            </ul>
        </div>
        <div class="main-content">
            <div class="user-info">
                @if (User.Identity.IsAuthenticated)
                {
                    <span><i class="fas fa-user-circle"></i> @User.Identity.Name</span>
                    <form method="post" action="/Account/Logout" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger ms-2">Выйти</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-sm btn-primary me-1">Вход</a>
                    <a href="/Account/Register" class="btn btn-sm btn-secondary">Регистрация</a>
                }
            </div>
            <div class="breadcrumb-area">
                <i class="fas fa-folder-open"></i>
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
                    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                }
                <a href="/">Dashboard</a> >
                @if (controller != "Home")
                {
                    <a href="/@controller">@controller</a> 
                    @(action != "Index" ? $" > {action}" : "")
                }
                else
                {
                    <span>Главная</span>
                }
            </div>
            @RenderBody()
            <footer>
                &copy; @DateTime.Now.Year - СМК Страхование
            </footer>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.sidebar-nav a').forEach(link => {
            if (link.getAttribute('href') === window.location.pathname) {
                link.classList.add('active');
            }
        });
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>