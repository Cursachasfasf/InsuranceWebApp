@model InsuranceWebApp.Models.Contract

@{
    ViewData["Title"] = "Редактировать договор";
    Layout = "_Layout";
}

<h1>Редактировать договор</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" action="/Contracts/Edit/@Model.contract_id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="contract_id" value="@Model.contract_id" />

            <div class="form-group">
                <label class="control-label">ID клиента</label>
                <input name="client_id" class="form-control" type="number" value="@Model.client_id" required />
            </div>
            <div class="form-group">
                <label class="control-label">ID продукта</label>
                <input name="product_id" class="form-control" type="number" value="@Model.product_id" required />
            </div>
            <div class="form-group">
                <label class="control-label">ID сотрудника</label>
                <input name="employee_id" class="form-control" type="number" value="@Model.employee_id" required />
            </div>
            <div class="form-group">
                <label class="control-label">Страховая премия</label>
                <input name="insurance_premium" class="form-control" step="0.01" value="@Model.insurance_premium" required />
            </div>
            <div class="form-group">
                <label class="control-label">Страховая сумма</label>
                <input name="insurance_amount" class="form-control" step="0.01" value="@Model.insurance_amount" required />
            </div>
            <div class="form-group">
                <label class="control-label">Дата начала</label>
                <input name="start_date" class="form-control" type="date" value="@Model.start_date.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="form-group">
                <label class="control-label">Дата окончания</label>
                <input name="end_date" class="form-control" type="date" value="@Model.end_date.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="form-group">
                <label class="control-label">Статус</label>
                <input name="status" class="form-control" value="@Model.status" required />
            </div>
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a href="/Contracts" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>