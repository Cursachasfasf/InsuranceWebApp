@model List<InsuranceWebApp.Controllers.UserRoleViewModel>

@{
    ViewData["Title"] = "Управление пользователями";
}

<h1>Управление пользователями</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-custom">
        <thead>
            <tr>
                <th>Email</th><th>ФИО</th><th>Текущая роль</th><th>Назначить роль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var isCurrentUser = user.Email == User.Identity.Name;
                <tr>
                    <td>@user.Email</td>
                    <td>@user.FullName</td>
                    <td>
                        @if (user.Roles.Contains("Admin"))
                        {
                            <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill">
                                <i class="fas fa-user-shield me-1"></i> Admin
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-secondary px-3 py-2 rounded-pill">
                                <i class="fas fa-user me-1"></i> User
                            </span>
                        }
                     </td>
                    <td>
                        @if (!isCurrentUser)
                        {
                            <form method="post" action="/Admin/AssignRole" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <select name="role" class="form-select form-select-sm w-auto rounded-pill border-soft">
                                    <option value="User">👤 User</option>
                                    <option value="Admin">🛡️ Admin</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                                    <i class="fas fa-save me-1"></i> Назначить
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">(Вы не можете изменить свою роль)</span>
                        }
                     </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="mt-4">
    <a href="/" class="btn btn-secondary rounded-pill px-4">
        <i class="fas fa-home me-2"></i> На главную
    </a>
</div>

<style>
    .border-soft {
        border-color: #f0e2e2;
    }
    .btn-primary {
        background: #d9a7a7;
        border: none;
        color: #4a2e2e;
    }
    .btn-primary:hover {
        background: #c48b8b;
        color: white;
    }
    .btn-secondary {
        background: #f5e6e6;
        border: none;
        color: #b96b6b;
    }
    .btn-secondary:hover {
        background: #e6d0d0;
        color: #9e5252;
    }
    .badge.bg-danger {
        background-color: #f8d7da !important;
        color: #b96b6b !important;
    }
    .badge.bg-secondary {
        background-color: #e9ecef !important;
        color: #6c757d !important;
    }
</style>