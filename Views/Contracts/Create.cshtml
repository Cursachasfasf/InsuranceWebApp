@model InsuranceWebApp.Models.Contract

@{
    ViewData["Title"] = "Добавить договор";
}

<h1>Добавить договор</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" action="/Contracts/Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="form-label">ID клиента</label>
                <input asp-for="client_id" class="form-control" type="number" />
                <span asp-validation-for="client_id" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">ID продукта</label>
                <input asp-for="product_id" class="form-control" type="number" />
                <span asp-validation-for="product_id" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">ID сотрудника</label>
                <input asp-for="employee_id" class="form-control" type="number" />
                <span asp-validation-for="employee_id" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Страховая премия</label>
                <input asp-for="insurance_premium" class="form-control" step="0.01" />
                <span asp-validation-for="insurance_premium" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Страховая сумма</label>
                <input asp-for="insurance_amount" class="form-control" step="0.01" />
                <span asp-validation-for="insurance_amount" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Дата начала</label>
                <input asp-for="start_date" class="form-control" type="date" />
                <span asp-validation-for="start_date" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Дата окончания</label>
                <input asp-for="end_date" class="form-control" type="date" />
                <span asp-validation-for="end_date" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Статус</label>
                <input asp-for="status" class="form-control" />
                <span asp-validation-for="status" class="text-danger"></span>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Создать</button>
                <a href="/Contracts" class="btn btn-secondary rounded-pill px-4">Назад</a>
            </div>
        </form>
    </div>
</div>