@model IEnumerable<InsuranceWebApp.Models.Payment>

@{
    ViewData["Title"] = "Платежи";
}

<h1>Платежи</h1>
<p>
    <a href="/Payments/Create" class="btn btn-success rounded-pill px-4">
        <i class="fas fa-plus me-1"></i> Добавить платёж
    </a>
</p>
<div class="table-responsive">
    <table class="table table-bordered table-custom">
        <thead>
            <tr>
                <th>ID платежа</th><th>Договор ID</th><th>Дата платежа</th><th>Сумма</th><th>Тип</th><th>Статус</th><th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.payment_id</td>
                    <td>@item.contract_id</td>
                    <td>@item.payment_date.ToShortDateString()</td>
                    <td>@item.amount.ToString("C")</td>
                    <td>@item.payment_type</td>
                    <td>@item.status</td>
                    <td>
                        <a href="/Payments/Edit/@item.payment_id" class="btn btn-action btn-edit">
                            <i class="fas fa-edit"></i> Редактировать
                        </a>
                        <a href="/Payments/Details/@item.payment_id" class="btn btn-action btn-details">
                            <i class="fas fa-info-circle"></i> Детали
                        </a>
                        <a href="/Payments/Delete/@item.payment_id" class="btn btn-action btn-delete">
                            <i class="fas fa-trash-alt"></i> Удалить
                        </a>
                     </td>
                </tr>
            }
        </tbody>
    </table>
</div>