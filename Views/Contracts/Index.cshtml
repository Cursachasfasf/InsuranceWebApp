@model IEnumerable<InsuranceWebApp.Models.Contract>

@{
    ViewData["Title"] = "Договоры";
    Layout = "_Layout";
}

<h1>Договоры</h1>
<p>
    <a href="/Contracts/Create" class="btn btn-success">+ Добавить договор</a>
</p>
<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>№ договора</th>
                <th>Клиент ID</th>
                <th>Продукт ID</th>
                <th>Сотрудник ID</th>
                <th>Страх. сумма</th>
                <th>Премия</th>
                <th>Дата начала</th>
                <th>Дата конца</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.contract_id</td>
                    <td>@item.client_id</td>
                    <td>@item.product_id</td>
                    <td>@item.employee_id</td>
                    <td>@item.insurance_amount.ToString("C")</td>
                    <td>@item.insurance_premium.ToString("C")</td>
                    <td>@item.start_date.ToShortDateString()</td>
                    <td>@item.end_date.ToShortDateString()</td>
                    <td>@item.status</td>
                    <td>
                        <a href="/Contracts/Edit/@item.contract_id" class="btn btn-sm btn-primary">Ред.</a>
                        <a href="/Contracts/Details/@item.contract_id" class="btn btn-sm btn-info">Дет.</a>
                        <a href="/Contracts/Delete/@item.contract_id" class="btn btn-sm btn-danger">Уд.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>