@model IEnumerable<InsuranceWebApp.Models.Client>

@{
    ViewData["Title"] = "Клиенты";
}

<h1>Клиенты</h1>
<p>
    <a href="/Clients/Create" class="btn btn-success rounded-pill px-4">
        <i class="fas fa-plus me-1"></i> Добавить клиента
    </a>
</p>
<div class="table-responsive">
    <table class="table table-bordered table-custom">
        <thead>
            <tr>
                <th>Имя</th>
                <th>Фамилия</th>
                <th>Отчество</th>
                <th>Телефон</th>
                <th>Адрес</th>
                <th>Email</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Step_Name</td>
                    <td>@(item.S_Step_Name ?? "—")</td>
                    <td>@item.phone</td>
                    <td>@item.address</td>
                    <td>@item.email</td>
                    <td>
                        <a href="/Clients/Edit/@item.client_id" class="btn btn-action btn-edit">
                            <i class="fas fa-edit"></i> Редактировать
                        </a>
                        <a href="/Clients/Details/@item.client_id" class="btn btn-action btn-details">
                            <i class="fas fa-info-circle"></i> Детали
                        </a>
                        <a href="/Clients/Delete/@item.client_id" class="btn btn-action btn-delete">
                            <i class="fas fa-trash-alt"></i> Удалить
                        </a>
                     </td>
                </tr>
            }
        </tbody>
    </table>
</div>