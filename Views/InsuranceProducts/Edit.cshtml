@model InsuranceWebApp.Models.InsuranceProduct

@{
    ViewData["Title"] = "Редактировать продукт";
    Layout = "_Layout";
}

<h1>Редактировать продукт</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" action="/InsuranceProducts/Edit/@Model.product_id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="product_id" value="@Model.product_id" />
            <div class="form-group"><label>Название</label><input name="Name" value="@Model.Name" class="form-control" required /></div>
            <div class="form-group"><label>Тип страхования</label><input name="insurance_type" value="@Model.insurance_type" class="form-control" required /></div>
            <div class="form-group"><label>Описание</label><textarea name="description" class="form-control">@Model.description</textarea></div>
            <div class="form-group"><label>Тариф (%)</label><input name="tariff_rate" value="@Model.tariff_rate" class="form-control" step="0.01" required /></div>
            <div class="form-group"><label>Мин. срок (дней)</label><input name="min_term_days" value="@Model.min_term_days" class="form-control" type="number" required /></div>
            <div class="form-group"><label>Макс. срок (дней)</label><input name="max_term_days" value="@Model.max_term_days" class="form-control" type="number" required /></div>
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a href="/InsuranceProducts" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>