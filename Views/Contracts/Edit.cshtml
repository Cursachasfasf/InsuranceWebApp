@model InsuranceWebApp.Models.Contract

@{
    ViewData["Title"] = "Редактировать договор";
}

<h1>Редактировать договор</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="contract_id" />
            <!-- все поля как в Create, но без client_id? client_id нужен, но скрыть или сделать readonly? Лучше дать выбрать -->
            <div class="form-group">
                <label asp-for="Number" class="control-label"></label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="client_id" class="control-label">Клиент</label>
                <select asp-for="client_id" class="form-control" asp-items="@(new SelectList(ViewBag.Clients, "client_id", "Name"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="product_id" class="control-label">Продукт</label>
                <select asp-for="product_id" class="form-control" asp-items="@(new SelectList(ViewBag.Products, "product_id", "Name"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="employee_id" class="control-label">Сотрудник</label>
                <select asp-for="employee_id" class="form-control" asp-items="@(new SelectList(ViewBag.Employees, "employee_id", "Name"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="insurance_premium" class="control-label"></label>
                <input asp-for="insurance_premium" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="insurance_amount" class="control-label"></label>
                <input asp-for="insurance_amount" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="start_date" class="control-label"></label>
                <input asp-for="start_date" class="form-control" type="date" />
            </div>
            <div class="form-group">
                <label asp-for="end_date" class="control-label"></label>
                <input asp-for="end_date" class="form-control" type="date" />
            </div>
            <div class="form-group">
                <label asp-for="status" class="control-label"></label>
                <input asp-for="status" class="form-control" />
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>